# Copie para .env.production NA VPS (nunca versionar) e preencha. Permissões: chmod 600 .env.production
NEXT_PUBLIC_APP_NAME="GenoLab"

# Domínio público do GenoLab (o mesmo usado no Caddyfile), com https
LAB_ALLOWED_ORIGINS=https://lab.seudominio.com.br
# O Caddy fica na frente do app: confiar no cabeçalho X-Forwarded-For dele
LAB_TRUST_PROXY=1
# Dados persistentes no volume Docker
LAB_DATA_DIR=/data
LAB_MAX_UPLOAD_BYTES=20971520

# E-mail(s) da administração inicial (contas que já nascem autorizadas)
GENO_LAB_ADMIN_EMAILS=seu-email@exemplo.com

# E-mails pré-autorizados (pesquisadores): a conta criada com eles já nasce autorizada (opcional).
# Sem confirmação de e-mail, vale para quem se cadastrar primeiro com o endereço; confira em Administração.
LAB_EMAILS_AUTORIZADOS=

# Contato para pedidos sobre dados pessoais (LGPD), exibido na página /privacidade (opcional)
LAB_CONTATO_PRIVACIDADE=

# Geninho (opcional): chave da API da Anthropic e, para chaves sem workspace, o ID do workspace
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5
