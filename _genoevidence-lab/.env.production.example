# Copie para .env.production NA VPS (nunca versionar) e preencha. Permissões: chmod 600 .env.production
NEXT_PUBLIC_APP_NAME="GenoLab"

# Domínio público do GenoLab (o mesmo usado no Caddyfile), com https
LAB_ALLOWED_ORIGINS=https://lab.seudominio.com.br
# O Caddy fica na frente do app: confiar no cabeçalho X-Forwarded-For dele
LAB_TRUST_PROXY=1
# Dados persistentes no volume Docker
LAB_DATA_DIR=/data
LAB_MAX_UPLOAD_BYTES=20971520

# E-mail(s) da administração inicial (contas que já nascem autorizadas)
GENO_LAB_ADMIN_EMAILS=seu-email@exemplo.com

# E-mails pré-autorizados (pesquisadores): a conta criada com eles já nasce autorizada (opcional).
# Sem confirmação de e-mail, vale para quem se cadastrar primeiro com o endereço; confira em Administração.
LAB_EMAILS_AUTORIZADOS=

# Contato para pedidos sobre dados pessoais (LGPD), exibido na página /privacidade (opcional)
LAB_CONTATO_PRIVACIDADE=

# Geninho (opcional): chave da API da Anthropic e, para chaves sem workspace, o ID do workspace
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5

# Geração de ilustrações por IA (opcional). Sem a chave, o Geninho não oferece a ferramenta
# e a página Integrações mostra "não configurada". Modelos: gpt-image-2.5-flare (rápido) ou
# gpt-image-2.5-sunburst (edição precisa). Os modelos de imagem podem exigir a verificação da
# organização no console da OpenAI.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Envio do registro do dia por e-mail (opcional).
# Sem isto, o GenoLab não finge enviar: oferece abrir o e-mail da pessoa já preenchido.
# Chave do Resend (resend.com). Crie a conta COM o e-mail que vai receber os registros.
RESEND_API_KEY=
# Remetente. Vazio => onboarding@resend.dev, que funciona sem DNS mas só entrega
# para o e-mail da conta do Resend. Para enviar a outras pessoas, verifique um
# domínio no Resend (SPF e DKIM no DNS) e use algo como:
# EMAIL_REMETENTE=GenoLab <caderno@genoevidence.com>
EMAIL_REMETENTE=
