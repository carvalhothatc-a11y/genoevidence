# Nome exibido da plataforma (provisório, configurável)
NEXT_PUBLIC_APP_NAME="GenoLab"

# Assistente científico (opcional). A chave fica SOMENTE no servidor.
# Sem ela, o Geninho mostra o estado "não configurado".
ANTHROPIC_API_KEY=
# Chaves de usuário (sk-ant-usr…) não pertencem a um workspace: informe o ID do workspace (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Modelo usado pelo assistente (padrão: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Pasta de armazenamento local (projetos, arquivos originais, extrações)
LAB_DATA_DIR=.lab-data

# Limites de importação (bytes)
LAB_MAX_UPLOAD_BYTES=20971520

# Supabase (ainda não conectado nesta versão — ver docs/INTEGRACOES.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Administração inicial (contas que já nascem autorizadas), separadas por vírgula
GENO_LAB_ADMIN_EMAILS=
# Produção: origens aceitas e proxy confiável (ver .env.production.example e docs/PUBLICAR.md)
LAB_ALLOWED_ORIGINS=
LAB_TRUST_PROXY=

# Envio do registro do dia por e-mail (opcional).
# Sem isto, o GenoLab não finge enviar: oferece abrir o e-mail da pessoa já preenchido.
# Chave do Resend (resend.com). Crie a conta COM o e-mail que vai receber os registros.
RESEND_API_KEY=
# Remetente. Vazio => onboarding@resend.dev, que funciona sem DNS mas só entrega
# para o e-mail da conta do Resend. Para enviar a outras pessoas, verifique um
# domínio no Resend (SPF e DKIM no DNS) e use algo como:
# EMAIL_REMETENTE=GenoLab <caderno@genoevidence.com>
EMAIL_REMETENTE=
