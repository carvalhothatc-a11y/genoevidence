{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "files.associations": { "*.webmanifest": "json" },
  "files.exclude": { "**/.DS_Store": true },
  "cSpell.language": "pt-BR,en",
  "livePreview.defaultPreviewPath": "/index.html",
  // baixa sozinho as novidades do GitHub (o robô grava notícias de hora em hora)
  "task.allowAutomaticTasks": "on",
  "git.autofetch": true
}
